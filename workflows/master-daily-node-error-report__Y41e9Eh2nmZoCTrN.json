        "id": "0d2fa156-61cc-4a7f-84f3-82497d7db7c3",
        "name": "Pick today error file",
        "parameters": {
          "jsCode": "const globals = $('Lookup global variables').first().json;\nconst offset = Number(globals.display_tz_offset_hours || 0);\nconst local = $now.plus({ hours: offset });\nconst fileDate = local.hour >= 20 ? local.plus({ days: 1 }) : local;\nconst y = fileDate.year;\nconst m = String(fileDate.month).padStart(2, '0');\nconst d = String(fileDate.day).padStart(2, '0');\nconst fileName = '/files/sortedsignals/logs/NODE_ERRORS_' + y + '_' + m + '_' + d + '.json';\nreturn [{ json: { fileName: fileName, g_email_id: globals.g_email_id, error_report_model: globals.error_report_model } }];",
          "language": "javaScript",
          "mode": "runOnceForAllItems"
        },
