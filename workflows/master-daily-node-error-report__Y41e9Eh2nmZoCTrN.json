      {
        "id": "75840e00-783b-46c2-8d96-f1c7a7de5f68",
        "name": "Summarize node errors",
        "parameters": {
          "batching": {},
          "promptType": "define",
          "text": "=Write a short operations status email for Sorted Signals.\n\nGroup repeated errors. Name the workflow and the node.\n\nIf this is a credits, payment, or HTTP 402 problem, say which billed service to top up. Use the `service` field when it is present. If it is missing:\n- Read listing page or Read article page, or InsufficientBalanceError / Payment required → Jina\n- Summarize/classify or other LLM nodes, or the error text mentions OpenRouter → OpenRouter\nDo not say “the account” without naming the vendor (Jina, OpenRouter, or whatever `service` says).\n\nKeep it under 400 words. Plain language. Email body only — no fake signature.\n\n## Error log\n{{ $json.logText }}"
        },
        "position": [
          1344,
          112
        ],
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "typeVersion": 1.8
