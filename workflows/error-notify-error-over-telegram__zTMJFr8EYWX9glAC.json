      {
        "id": "cd6e6102-daca-4b08-b4a5-e2ff52b332ea",
        "name": "Prepare file logs",
        "parameters": {
          "jsCode": "function asPlain(v) {\n  if (v == null) return v;\n  if (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean') return v;\n  try { return JSON.parse(JSON.stringify(v)); } catch (e) { return String(v); }\n}\nfunction probeTelegram() {\n  try {\n    const item = $('Check Telegram').first();\n    const j = (item && item.json) || {};\n    const err = j.error || (item && item.error);\n    if (err) return { ok: false, json: asPlain(j), error: asPlain(err) };\n    if (j.ok === true) return { ok: true, json: asPlain(j) };\n    return { ok: false, json: asPlain(j), error: null };\n  } catch (e) {\n    return { ok: false, json: {}, error: { message: String(e.message || e) } };\n  }\n}\nconst original = asPlain($('On error').first().json);\nconst probe = probeTelegram();\nlet fallback;\nif (!probe.ok) {\n  fallback = {\n    kind: 'telegram_unavailable',\n    message: 'Telegram is not set up to handle error notifications.',\n    checkTelegram: probe.json,\n    checkError: probe.error,\n    loggedAt: new Date().toISOString(),\n  };\n} else {\n  const item = $input.first();\n  const j = (item && item.json) || {};\n  const err = (item && item.error) || j.error;\n  fallback = {\n    kind: 'telegram_send_failed',\n    message: 'Telegram message failed.',\n    telegramSend: asPlain(j),\n    telegramError: asPlain(err),\n    loggedAt: new Date().toISOString(),\n  };\n}\nreturn [{ json: original }, { json: fallback }];",
          "mode": "runOnceForAllItems"
        },
