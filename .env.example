# Copy to .env and fill in. Do not commit .env.

# Public hostname (no protocol). Used behind a reverse proxy.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/

# n8n basic auth (change these)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Shared secret between n8n-main and task-runners. Use a long random string.
N8N_RUNNERS_AUTH_TOKEN=change-me-to-a-long-random-token

# Instance timezone (schedules in Sorted Signals are written as UTC)
GENERIC_TIMEZONE=UTC
TZ=UTC
